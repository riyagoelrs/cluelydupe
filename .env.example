# Copy to .env only if you want to override the in-app Setup defaults.
# Never commit the real .env file.
#
# The default stack is fully local: no API key, no account, and your call/prep
# material stays on your machine. The Setup panel can choose/download Whisper's
# model and shows the macOS permissions and Ollama pieces that are still missing.

# --- transcription ----------------------------------------------------------
# whisper (local, no key) | deepgram (cloud, needs a key)
STT_PROVIDER=whisper
# Optional. Leave blank and cluely will auto-detect common locations, including
# ~/ggml-base.en.bin, or use Setup → Download base.en / Choose… inside the app.
WHISPER_MODEL=
# Binary name or path. `brew install whisper-cpp` puts whisper-cli on PATH.
WHISPER_BINARY=whisper-cli
WHISPER_THREADS=4
STT_LANGUAGE=en

# --- answers ----------------------------------------------------------------
# ollama (local, no key) | claude (cloud, needs a key)
ANSWER_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# llama3.1:8b is a good default on 16GB. qwen2.5:14b is sharper if you have room;
# llama3.2:3b is the fallback if answers arrive too late.
OLLAMA_MODEL=llama3.1:8b
# Multimodal model, used only when you attach the screen (Cmd/Ctrl+Shift+S).
# ollama pull llava:7b
OLLAMA_VISION_MODEL=llava:7b
# Embedding model for materials search. Blank turns embeddings off and falls
# back to keyword search, which still works.
OLLAMA_EMBED_MODEL=nomic-embed-text
ANSWER_MAX_TOKENS=1200
# Answer question-shaped utterances without being asked.
AUTO_ANSWER=true
# Transcript lines handed to the model with each question.
CONTEXT_LINES=24

# --- your materials ---------------------------------------------------------
# Folder containing the locally indexed text copies created by the Files panel.
# Defaults to ./materials.
# MATERIALS_DIR=
# How many matching passages to put in front of the model.
MATERIALS_TOP_K=4

# --- capture ----------------------------------------------------------------
# Leave empty to capture system audio via loopback (Windows, and macOS 14.4+).
# Set it to part of an input device's name to read from a virtual cable instead,
# e.g. "BlackHole", "VB-Audio", "Monitor of".
SYSTEM_AUDIO_DEVICE=

# --- overlay ----------------------------------------------------------------
# Keeps the overlay out of screen shares and screenshots. Set false to debug.
CONTENT_PROTECTION=true
# Optional absolute path to the notes file. Notes are editable in-app by default.
# CLUELY_CONTEXT=

# --- cloud fallback (only needed if you switch the providers above) ----------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ANSWER_MODEL=claude-opus-5
ANSWER_EFFORT=low
ANSWER_THINKING=off
DEEPGRAM_MODEL=nova-3
